from __future__ import annotations

import argparse
import sys
from pathlib import Path


# Justify configuration values instead of leaving unexplained magic numbers.
DEFAULT_TIMEOUT_SECONDS = 30


def process(input_path: Path, output_path: Path | None) -> int:
    """Process the input and write an output when requested."""
    if not input_path.exists():
        print(f"ERROR: input not found: {input_path}", file=sys.stderr)
        return 1

    content = input_path.read_text(encoding="utf-8")
    result = content.strip()

    if output_path is None:
        print(result)
    else:
        output_path.parent.mkdir(parents=True, exist_ok=True)
        output_path.write_text(result + "\n", encoding="utf-8", newline="\n")
        print(f"wrote {output_path}")

    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="TODO: describe this script.")
    parser.add_argument("input", type=Path, help="Input file to process")
    parser.add_argument("-o", "--output", type=Path, help="Optional output file")
    args = parser.parse_args()
    return process(args.input, args.output)


if __name__ == "__main__":
    sys.exit(main())
